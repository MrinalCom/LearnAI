POSTGRES_USER=learnai
POSTGRES_PASSWORD=learnai_dev_password
POSTGRES_DB=learnai
DATABASE_URL=postgresql://learnai:learnai_dev_password@postgres:5432/learnai

REDIS_URL=redis://redis:6379

JWT_SECRET=change_me_dev_secret

# Get this from console.anthropic.com — separate from a claude.ai Pro subscription.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Get this from dashboard.voyageai.com (Anthropic's recommended embeddings partner).
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-3

# Get this from e2b.dev — used for sandboxed server-side code execution (Tier 3 playgrounds).
E2B_API_KEY=your_e2b_api_key_here

PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
